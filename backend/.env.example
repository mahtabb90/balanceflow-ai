DATABASE_URL=postgresql://username:password@host/database?sslmode=require
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# "development" enables localhost CORS origins and /docs. Anything else is production.
APP_ENV=production

# Explicit comma-separated allowlist of frontend origins (no wildcards), e.g. your Vercel URL.
CORS_ORIGINS=https://your-frontend.vercel.app

# Legacy shared-database routes. Flags are NOT authentication: access also needs an
# authenticated user, which does not exist yet, so these stay closed. Leave unset.
# ENABLE_SHARED_DATA_API=false
# ENABLE_DESTRUCTIVE_ENDPOINTS=false

# Stateless demo insights protection (optional overrides)
# GEMINI_DAILY_REQUEST_LIMIT=100
# GEMINI_TIMEOUT_SECONDS=15
# DEMO_RATE_LIMIT_PER_MINUTE=5
